{
	"name": "tight-lines-game",
	"version": "1.0.0",
	"description": "Pixel Fishing game",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "vite",
		"desktop:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
		"desktop": "npm run build && electron .",
		"build": "vite build",
		"preview": "vite preview",
		"dist": "npm run dist:win",
		"dist:win": "npm run build && electron-builder --win portable --x64",
		"dist:win:arm64": "npm run build && electron-builder --win portable --arm64",
		"dist:mac": "npm run build && electron-builder --mac zip"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rusrap3547/tight-lines-game-js.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/rusrap3547/tight-lines-game-js/issues"
	},
	"homepage": "https://github.com/rusrap3547/tight-lines-game-js#readme",
	"dependencies": {
		"phaser": "^3.90.0",
		"vite": "^7.3.0"
	},
	"devDependencies": {
		"concurrently": "^9.2.1",
		"electron": "^42.1.0",
		"electron-builder": "^26.8.1",
		"wait-on": "^9.0.10"
	},
	"build": {
		"appId": "com.tightlines.game",
		"productName": "Tight Lines",
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json"
		],
		"directories": {
			"output": "release"
		},
		"mac": {
			"target": [
				"zip"
			],
			"category": "public.app-category.games"
		},
		"win": {
			"target": [
				"portable"
			]
		},
		"linux": {
			"target": [
				"AppImage"
			]
		}
	}
}
